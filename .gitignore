# ---------- 依赖 ----------
web/node_modules/
server/.mvn/wrapper/*.jar

# ---------- 构建产物 ----------
web/dist/
web/.vite/
server/target/
*.class

# ---------- 运行数据（数据库、上传文件、向量库数据、日志）----------
data/
logs/
*.log

# ---------- 本机工具与二进制（Qdrant 可执行文件等，按 README 自行下载）----------
tools/

# ---------- 验证与调试产物 ----------
.verify/
.shots/
*.tmp

# ---------- 本地环境 ----------
.env
.env.local
.DS_Store
Thumbs.db

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.iml

# ---------- 智能体工作区（本地会话记忆，不入库）----------
.workbuddy/
